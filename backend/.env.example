# ─────────────────────────────────────────────────────────────
# VendorBridge Backend — Environment Configuration
# Copy this file to `.env` and fill in real values.
# Every value below has a safe default so the server boots with ZERO setup
# (it will spin up an in-memory MongoDB when MONGODB_URI is left blank).
# ─────────────────────────────────────────────────────────────

# Server
NODE_ENV=development
PORT=5000
# Comma-separated list of allowed origins for CORS (frontend dev server).
CORS_ORIGIN=http://localhost:5173

# Database
# Leave MONGODB_URI EMPTY to use an automatic in-memory MongoDB (great for demos/hackathon).
# Set it to a real connection string for persistence (MongoDB Atlas or local mongod).
MONGODB_URI=
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/vendorbridge

# Auth / JWT
JWT_SECRET=change_me_super_secret_dev_key
JWT_EXPIRE=7d
COOKIE_SECRET=change_me_cookie_secret

# Seeding — when true, the server seeds demo data on boot if the DB is empty.
SEED_ON_START=true

# Cloudinary (optional — RFQ attachment uploads). Leave blank to disable cloud storage.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Email / SMTP (optional — invoice & notification mails). Leave blank to log mails to console instead of sending.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=VendorBridge <no-reply@vendorbridge.com>

# Business config
INVOICE_TAX_RATE=0.18
INVOICE_DUE_DAYS=30
